# Server
PORT=8080
ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (docker-compose maps host 5433 -> container 5432)
DATABASE_URL=postgres://chainmind:chainmind@localhost:5433/chainmind?sslmode=disable

# LLM Providers
# Development only: set to "mock" (with ENV=development) to run without keys.
DEFAULT_LLM_PROVIDER=anthropic
# Leave empty to run without live analysis; health reports llm_api as down.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LLM Models
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# RAG
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.75